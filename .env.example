# Safe local-development defaults. Copy to .env and change as needed.
FLASK_ENV=development
FLASK_DEBUG=1
BACKEND_PORT=5000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Replace placeholders locally; URL-encode password characters in DATABASE_URL.
DATABASE_URL=mysql+pymysql://ayursage:change-me@127.0.0.1:3307/ayursage_dev?charset=utf8mb4
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_PORT=3307

# ML is intentionally unavailable until the verified frozen V17 package arrives.
ML_ENABLED=false

# Generate unique production secrets; never commit their values.
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=1209600
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# Set only while running the one-time bootstrap command, then remove it.
ADMIN_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-bytes
